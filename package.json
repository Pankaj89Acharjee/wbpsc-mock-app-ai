{
  "name": "wbpsc-ai-prep",
  "private": true,
  "version": "1.0.0",
  "description": "WBPSC AI Mock Test & Tutor Monorepo (Expo Mobile, Next.js 15 Web, Fastify Core API, FastAPI AI Service)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:api-core": "tsx --test apps/api-core/test/*.test.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "infra:logs": "docker compose logs -f",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api-core": "npm --workspace=apps/api-core run dev",
    "dev:mobile:lan": "npm --workspace=apps/mobile run start -- --lan",
    "dev:api-ai": "node scripts/dev-api-ai.mjs",
    "typecheck:shared": "npm --workspace=@wbpsc/shared-types run typecheck",
    "db:push": "npm --workspace=apps/api-core run db:push",
    "db:migrate": "npm --workspace=apps/api-core run db:migrate",
    "seed:syllabus": "tsx scripts/seed-syllabus.ts",
    "seed": "tsx scripts/seed-postgres.ts",
    "seed:dry": "tsx scripts/seed-postgres.ts --dry-run",
    "seed:file": "tsx scripts/seed-postgres.ts --file="
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "fastify": "^5.12.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postgres": "^3.4.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
