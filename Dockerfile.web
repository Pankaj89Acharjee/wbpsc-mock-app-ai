# ============================================================================
# WBPSC web app (React/Vite build served by server.ts) + repo tooling
# Context: monorepo root — `docker build -f Dockerfile.web .`
# Also used for one-off jobs on the VM: db:push, seed:syllabus, seed.
# ============================================================================
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json pnpm-workspace.yaml ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/api-core/package.json ./apps/api-core/
# --legacy-peer-deps: vite 8 prefers a newer esbuild than drizzle-kit pins (harmless)
RUN npm install --no-audit --no-fund --legacy-peer-deps

COPY . .

# Browser calls api-core through the reverse proxy on the same domain
ARG VITE_API_CORE_URL=/api
ENV VITE_API_CORE_URL=${VITE_API_CORE_URL}
RUN npx vite build

ENV NODE_ENV=production
EXPOSE 3000
CMD ["npx", "tsx", "server.ts"]
