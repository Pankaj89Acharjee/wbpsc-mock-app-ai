2026-10-26 16:11:20.853 | 2026-10-26 10:41:20.852 UTC [97438] STATEMENT:  -- ============================================================================
2026-10-26 16:11:20.853 | 	-- 0004 Papers go away: a SERIES is the test.
2026-10-26 16:11:20.853 | 	--
2026-10-26 16:11:20.853 | 	-- A series already defines the pattern (subjects + question counts, optional
2026-10-26 16:11:20.853 | 	-- topic breakdown) and the marking scheme, so it now also holds its selected
2026-10-26 16:11:20.853 | 	-- questions directly and is what students sit.
2026-10-26 16:11:20.853 | 	--
2026-10-26 16:11:20.853 | 	--   paper_questions                   → series_questions
2026-10-26 16:11:20.853 | 	--   question_ingestion_jobs.target_paper_id → target_series_id
2026-10-26 16:11:20.853 | 	--   test_attempts.paper_id            → series_id
2026-10-26 16:11:20.853 | 	--   exam_papers                       → dropped
2026-10-26 16:11:20.853 | 	--
2026-10-26 16:11:20.853 | 	-- Backfill: each series takes the questions of its one paper that has any.
2026-10-26 16:11:20.853 | 	-- If a series has questions in more than one paper, the migration stops (no
2026-10-26 16:11:20.853 | 	-- guessing which to keep) — leave questions in one paper per series, re-run.
2026-10-26 16:11:20.853 | 	-- A published series that isn't complete afterwards goes back to draft, so
2026-10-26 16:11:20.853 | 	-- students never see a test with missing questions. Idempotent: safe to re-run.
2026-10-26 16:11:20.853 | 	-- ============================================================================
2026-10-26 16:11:20.853 | 	
2026-10-26 16:11:20.853 | 	CREATE TABLE IF NOT EXISTS series_questions (
2026-10-26 16:11:20.853 | 	  id uuid PRIMARY KEY DEFAULT uuid_generate_v4(),
2026-10-26 16:11:20.853 | 	  series_id uuid NOT NULL,
2026-10-26 16:11:20.853 | 	  exam_id uuid NOT NULL,
2026-10-26 16:11:20.853 | 	  question_id uuid NOT NULL REFERENCES questions (id) ON DELETE RESTRICT,
2026-10-26 16:11:20.853 | 	  subject_id uuid NOT NULL,
2026-10-26 16:11:20.853 | 	  chapter_id uuid NOT NULL REFERENCES chapters (id) ON DELETE RESTRICT,
2026-10-26 16:11:20.853 | 	  subtopic_id uuid NOT NULL REFERENCES subtopics (id) ON DELETE RESTRICT,
2026-10-26 16:11:20.853 | 	  position integer NOT NULL DEFAULT 0,
2026-10-26 16:11:20.853 | 	  assigned_by uuid REFERENCES users (id) ON DELETE SET NULL,
2026-10-26 16:11:20.853 | 	  created_at timestamptz NOT NULL DEFAULT now(),
2026-10-26 16:11:20.853 | 	  CONSTRAINT series_questions_series_fk FOREIGN KEY (series_id, exam_id)
2026-10-26 16:11:20.853 | 	    REFERENCES exam_series (id, exam_id) ON DELETE CASCADE,
2026-10-26 16:11:20.853 | 	  CONSTRAINT series_questions_subject_fk FOREIGN KEY (subject_id, exam_id)
2026-10-26 16:11:20.853 | 	    REFERENCES subjects (id, exam_id) ON DELETE RESTRICT
2026-10-26 16:11:20.853 | 	);
2026-10-26 16:11:20.853 | 	-- The same question can never appear twice in one series
2026-10-26 16:11:20.853 | 	CREATE UNIQUE INDEX IF NOT EXISTS series_questions_series_question_unique_idx ON series_questions (series_id, question_id);
2026-10-26 16:11:20.853 | 	CREATE INDEX IF NOT EXISTS series_questions_question_idx ON series_questions (question_id);
2026-10-26 16:11:20.853 | 	CREATE INDEX IF NOT EXISTS series_questions_series_subtopic_idx ON series_questions (series_id, subtopic_id);
2026-10-26 16:11:20.853 | 	
2026-10-26 16:11:20.853 | 	ALTER TABLE test_attempts
2026-10-26 16:11:20.853 | 	  ADD COLUMN IF NOT EXISTS series_id uuid REFERENCES exam_series (id) ON DELETE SET NULL;
2026-10-26 16:11:20.854 | 	CREATE INDEX IF NOT EXISTS test_attempts_series_idx ON test_attempts (series_id);
2026-10-26 16:11:20.854 | 	
2026-10-26 16:11:20.854 | 	ALTER TABLE question_ingestion_jobs
2026-10-26 16:11:20.854 | 	  ADD COLUMN IF NOT EXISTS target_series_id uuid REFERENCES exam_series (id) ON DELETE SET NULL;
2026-10-26 16:11:20.854 | 	CREATE INDEX IF NOT EXISTS ingestion_jobs_target_series_idx ON question_ingestion_jobs (target_series_id, status);
2026-10-26 16:11:20.854 | 	
2026-10-26 16:11:20.854 | 	DO $$
2026-10-26 16:11:20.854 | 	DECLARE
2026-10-26 16:11:20.854 | 	  clash text;
2026-10-26 16:11:20.854 | 	  demoted text;
2026-10-26 16:11:20.854 | 	BEGIN
2026-10-26 16:11:20.854 | 	  IF to_regclass('public.exam_papers') IS NULL THEN
2026-10-26 16:11:20.854 | 	    RETURN;
2026-10-26 16:11:20.854 | 	  END IF;
2026-10-26 16:11:20.854 | 	
2026-10-26 16:11:20.854 | 	  SELECT string_agg(s.name ->> 'en', ', ') INTO clash
2026-10-26 16:11:20.854 | 	  FROM exam_series s
2026-10-26 16:11:20.854 | 	  WHERE (
2026-10-26 16:11:20.854 | 	    SELECT count(DISTINCT pq.paper_id)
2026-10-26 16:11:20.854 | 	    FROM paper_questions pq JOIN exam_papers p ON p.id = pq.paper_id
2026-10-26 16:11:20.854 | 	    WHERE p.series_id = s.id
2026-10-26 16:11:20.854 | 	  ) > 1;
2026-10-26 16:11:20.854 | 	  IF clash IS NOT NULL THEN
2026-10-26 16:11:20.854 | 	    RAISE EXCEPTION 'Series with questions in more than one paper: %. Keep questions in one paper per series, then re-run the migration.', clash;
2026-10-26 16:11:20.854 | 	  END IF;
2026-10-26 16:11:20.854 | 	
2026-10-26 16:11:20.854 | 	  INSERT INTO series_questions (series_id, exam_id, question_id, subject_id, chapter_id, subtopic_id, position, assigned_by, created_at)
2026-10-26 16:11:20.854 | 	  SELECT p.series_id, pq.exam_id, pq.question_id, pq.subject_id, pq.chapter_id, pq.subtopic_id, pq.position, pq.assigned_by, pq.created_at
2026-10-26 16:11:20.854 | 	  FROM paper_questions pq
2026-10-26 16:11:20.854 | 	  JOIN exam_papers p ON p.id = pq.paper_id
2026-10-26 16:11:20.854 | 	  ON CONFLICT DO NOTHING;
2026-10-26 16:11:20.854 | 	
2026-10-26 16:11:20.854 | 	  UPDATE test_attempts a SET series_id = p.series_id
2026-10-26 16:11:20.854 | 	  FROM exam_papers p
2026-10-26 16:11:20.854 | 	  WHERE a.paper_id = p.id AND a.series_id IS NULL;
2026-10-26 16:11:20.854 | 	
2026-10-26 16:11:20.854 | 	  UPDATE question_ingestion_jobs j SET target_series_id = p.series_id
2026-10-26 16:11:20.854 | 	  FROM exam_papers p
2026-10-26 16:11:20.854 | 	  WHERE j.target_paper_id = p.id AND j.target_series_id IS NULL;
2026-10-26 16:11:20.854 | 	
2026-10-26 16:11:20.854 | 	  -- A published series must be a complete test
2026-10-26 16:11:20.854 | 	  WITH totals AS (
2026-10-26 16:11:20.854 | 	    SELECT s.id,
2026-10-26 16:11:20.854 | 	           coalesce((SELECT sum(r.target_count) FROM series_roster_slots r
2026-10-26 16:11:20.854 | 	                     WHERE r.series_id = s.id AND r.chapter_id IS NULL), 0) AS target,
2026-10-26 16:11:20.854 | 	           (SELECT count(*) FROM series_questions q WHERE q.series_id = s.id) AS selected
2026-10-26 16:11:20.854 | 	    FROM exam_series s
2026-10-26 16:11:20.854 | 	    WHERE s.status = 'published'
2026-10-26 16:11:20.854 | 	  ), changed AS (
2026-10-26 16:11:20.854 | 	    UPDATE exam_series s SET status = 'draft', updated_at = now()
2026-10-26 16:11:20.854 | 	    FROM totals t
2026-10-26 16:11:20.854 | 	    WHERE s.id = t.id AND (t.target = 0 OR t.selected <> t.target)
2026-10-26 16:11:20.854 | 	    RETURNING s.name ->> 'en' AS name
2026-10-26 16:11:20.854 | 	  )
2026-10-26 16:11:20.854 | 	  SELECT string_agg(name, ', ') INTO demoted FROM changed;
2026-10-26 16:11:20.854 | 	  IF demoted IS NOT NULL THEN
2026-10-26 16:11:20.854 | 	    RAISE NOTICE 'Moved back to draft (questions not complete yet): %', demoted;
2026-10-26 16:11:20.854 | 	  END IF;
2026-10-26 16:11:20.854 | 	
2026-10-26 16:11:20.854 | 	  ALTER TABLE test_attempts DROP COLUMN IF EXISTS paper_id;
2026-10-26 16:11:20.854 | 	  ALTER TABLE question_ingestion_jobs DROP COLUMN IF EXISTS target_paper_id;
2026-10-26 16:11:20.854 | 	  DROP TABLE IF EXISTS paper_questions;
2026-10-26 16:11:20.854 | 	  DROP TABLE IF EXISTS exam_papers;
2026-10-26 16:11:20.854 | 	END $$;
