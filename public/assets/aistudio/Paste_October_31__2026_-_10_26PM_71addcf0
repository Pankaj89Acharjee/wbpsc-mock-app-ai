2026-10-26 11:53:15.503 | 	-- A series already defines the pattern (subjects + question counts, optional
2026-10-26 11:53:15.503 | 	-- topic breakdown) and the marking scheme, so it now also holds its selected
2026-10-26 11:53:15.503 | 	-- questions directly and is what students sit.
2026-10-26 11:53:15.503 | 	--
2026-10-26 11:53:15.503 | 	--   paper_questions                   → series_questions
2026-10-26 11:53:15.503 | 	--   question_ingestion_jobs.target_paper_id → target_series_id
2026-10-26 11:53:15.503 | 	--   test_attempts.paper_id            → series_id
2026-10-26 11:53:15.503 | 	--   exam_papers                       → dropped
2026-10-26 11:53:15.503 | 	--
2026-10-26 11:53:15.503 | 	-- Backfill: each series takes the questions of its one paper that has any.
2026-10-26 11:53:15.503 | 	-- If a series has questions in more than one paper, the migration stops (no
2026-10-26 11:53:15.503 | 	-- guessing which to keep) — leave questions in one paper per series, re-run.
2026-10-26 11:53:15.503 | 	-- A published series that isn't complete afterwards goes back to draft, so
2026-10-26 11:53:15.503 | 	-- students never see a test with missing questions. Idempotent: safe to re-run.
2026-10-26 11:53:15.503 | 	-- ============================================================================
2026-10-26 11:53:15.503 | 	
2026-10-26 11:53:15.503 | 	CREATE TABLE IF NOT EXISTS series_questions (
2026-10-26 11:53:15.503 | 	  id uuid PRIMARY KEY DEFAULT uuid_generate_v4(),
2026-10-26 11:53:15.503 | 	  series_id uuid NOT NULL,
2026-10-26 11:53:15.503 | 	  exam_id uuid NOT NULL,
2026-10-26 11:53:15.503 | 	  question_id uuid NOT NULL REFERENCES questions (id) ON DELETE RESTRICT,
2026-10-26 11:53:15.503 | 	  subject_id uuid NOT NULL,
2026-10-26 11:53:15.503 | 	  chapter_id uuid NOT NULL REFERENCES chapters (id) ON DELETE RESTRICT,
2026-10-26 11:53:15.503 | 	  subtopic_id uuid NOT NULL REFERENCES subtopics (id) ON DELETE RESTRICT,
2026-10-26 11:53:15.503 | 	  position integer NOT NULL DEFAULT 0,
2026-10-26 11:53:15.503 | 	  assigned_by uuid REFERENCES users (id) ON DELETE SET NULL,
2026-10-26 11:53:15.503 | 	  created_at timestamptz NOT NULL DEFAULT now(),
2026-10-26 11:53:15.503 | 	  CONSTRAINT series_questions_series_fk FOREIGN KEY (series_id, exam_id)
2026-10-26 11:53:15.503 | 	    REFERENCES exam_series (id, exam_id) ON DELETE CASCADE,
2026-10-26 11:53:15.503 | 	  CONSTRAINT series_questions_subject_fk FOREIGN KEY (subject_id, exam_id)
2026-10-26 11:53:15.503 | 	    REFERENCES subjects (id, exam_id) ON DELETE RESTRICT
2026-10-26 11:53:15.503 | 	);
2026-10-26 11:53:15.503 | 	-- The same question can never appear twice in one series
2026-10-26 11:53:15.503 | 	CREATE UNIQUE INDEX IF NOT EXISTS series_questions_series_question_unique_idx ON series_questions (series_id, question_id);
2026-10-26 11:53:15.503 | 	CREATE INDEX IF NOT EXISTS series_questions_question_idx ON series_questions (question_id);
2026-10-26 11:53:15.503 | 	CREATE INDEX IF NOT EXISTS series_questions_series_subtopic_idx ON series_questions (series_id, subtopic_id);
2026-10-26 11:53:15.503 | 	
2026-10-26 11:53:15.503 | 	ALTER TABLE test_attempts
2026-10-26 11:53:15.503 | 	  ADD COLUMN IF NOT EXISTS series_id uuid REFERENCES exam_series (id) ON DELETE SET NULL;
2026-10-26 11:53:15.503 | 	CREATE INDEX IF NOT EXISTS test_attempts_series_idx ON test_attempts (series_id);
2026-10-26 11:53:15.503 | 	
2026-10-26 11:53:15.503 | 	ALTER TABLE question_ingestion_jobs
2026-10-26 11:53:15.503 | 	  ADD COLUMN IF NOT EXISTS target_series_id uuid REFERENCES exam_series (id) ON DELETE SET NULL;
2026-10-26 11:53:15.503 | 	CREATE INDEX IF NOT EXISTS ingestion_jobs_target_series_idx ON question_ingestion_jobs (target_series_id, status);
2026-10-26 11:53:15.503 | 	
2026-10-26 11:53:15.503 | 	DO $$
2026-10-26 11:53:15.503 | 	DECLARE
2026-10-26 11:53:15.503 | 	  clash text;
2026-10-26 11:53:15.503 | 	  demoted text;
2026-10-26 11:53:15.503 | 	BEGIN
2026-10-26 11:53:15.503 | 	  IF to_regclass('public.exam_papers') IS NULL THEN
2026-10-26 11:53:15.503 | 	    RETURN;
2026-10-26 11:53:15.503 | 	  END IF;
2026-10-26 11:53:15.503 | 	
2026-10-26 11:53:15.503 | 	  SELECT string_agg(s.name ->> 'en', ', ') INTO clash
2026-10-26 11:53:15.503 | 	  FROM exam_series s
2026-10-26 11:53:15.503 | 	  WHERE (
2026-10-26 11:53:15.503 | 	    SELECT count(DISTINCT pq.paper_id)
2026-10-26 11:53:15.503 | 	    FROM paper_questions pq JOIN exam_papers p ON p.id = pq.paper_id
2026-10-26 11:53:15.503 | 	    WHERE p.series_id = s.id
2026-10-26 11:53:15.503 | 	  ) > 1;
2026-10-26 11:53:15.503 | 	  IF clash IS NOT NULL THEN
2026-10-26 11:53:15.503 | 	    RAISE EXCEPTION 'Series with questions in more than one paper: %. Keep questions in one paper per series, then re-run the migration.', clash;
2026-10-26 11:53:15.503 | 	  END IF;
2026-10-26 11:53:15.503 | 	
2026-10-26 11:53:15.503 | 	  INSERT INTO series_questions (series_id, exam_id, question_id, subject_id, chapter_id, subtopic_id, position, assigned_by, created_at)
2026-10-26 11:53:15.503 | 	  SELECT p.series_id, pq.exam_id, pq.question_id, pq.subject_id, pq.chapter_id, pq.subtopic_id, pq.position, pq.assigned_by, pq.created_at
2026-10-26 11:53:15.503 | 	  FROM paper_questions pq
2026-10-26 11:53:15.503 | 	  JOIN exam_papers p ON p.id = pq.paper_id
2026-10-26 11:53:15.503 | 	  ON CONFLICT DO NOTHING;
2026-10-26 11:53:15.503 | 	
2026-10-26 11:53:15.503 | 	  UPDATE test_attempts a SET series_id = p.series_id
2026-10-26 11:53:15.503 | 	  FROM exam_papers p
2026-10-26 11:53:15.503 | 	  WHERE a.paper_id = p.id AND a.series_id IS NULL;
2026-10-26 11:53:15.503 | 	
2026-10-26 11:53:15.503 | 	  UPDATE question_ingestion_jobs j SET target_series_id = p.series_id
2026-10-26 11:53:15.503 | 	  FROM exam_papers p
2026-10-26 11:53:15.503 | 	  WHERE j.target_paper_id = p.id AND j.target_series_id IS NULL;
2026-10-26 11:53:15.503 | 	
2026-10-26 11:53:15.503 | 	  -- A published series must be a complete test
2026-10-26 11:53:15.503 | 	  WITH totals AS (
2026-10-26 11:53:15.503 | 	    SELECT s.id,
2026-10-26 11:53:15.503 | 	           coalesce((SELECT sum(r.target_count) FROM series_roster_slots r
2026-10-26 11:53:15.503 | 	                     WHERE r.series_id = s.id AND r.chapter_id IS NULL), 0) AS target,
2026-10-26 11:53:15.503 | 	           (SELECT count(*) FROM series_questions q WHERE q.series_id = s.id) AS selected
2026-10-26 11:53:15.503 | 	    FROM exam_series s
2026-10-26 11:53:15.503 | 	    WHERE s.status = 'published'
2026-10-26 11:53:15.503 | 	  ), changed AS (
2026-10-26 11:53:15.503 | 	    UPDATE exam_series s SET status = 'draft', updated_at = now()
2026-10-26 11:53:15.504 | 	    FROM totals t
2026-10-26 11:53:15.504 | 	    WHERE s.id = t.id AND (t.target = 0 OR t.selected <> t.target)
2026-10-26 11:53:15.504 | 	    RETURNING s.name ->> 'en' AS name
2026-10-26 11:53:15.504 | 	  )
2026-10-26 11:53:15.504 | 	  SELECT string_agg(name, ', ') INTO demoted FROM changed;
2026-10-26 11:53:15.504 | 	  IF demoted IS NOT NULL THEN
2026-10-26 11:53:15.504 | 	    RAISE NOTICE 'Moved back to draft (questions not complete yet): %', demoted;
2026-10-26 11:53:15.504 | 	  END IF;
2026-10-26 11:53:15.504 | 	
2026-10-26 11:53:15.504 | 	  ALTER TABLE test_attempts DROP COLUMN IF EXISTS paper_id;
2026-10-26 11:53:15.504 | 	  ALTER TABLE question_ingestion_jobs DROP COLUMN IF EXISTS target_paper_id;
2026-10-26 11:53:15.504 | 	  DROP TABLE IF EXISTS paper_questions;
2026-10-26 11:53:15.504 | 	  DROP TABLE IF EXISTS exam_papers;
2026-10-26 11:53:15.504 | 	END $$;
