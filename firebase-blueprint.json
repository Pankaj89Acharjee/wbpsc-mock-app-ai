{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated WBPSC aspirant, educator, or admin profile with RBAC role and subscription tier.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "User email address (PII restricted to owner or admin)"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full name of the user"
        },
        "role": {
          "type": "string",
          "enum": ["aspirant", "educator", "admin"],
          "description": "RBAC role enforced by Firestore rules"
        },
        "subscriptionTier": {
          "type": "string",
          "enum": ["free", "pro_prelims", "wbcs_executive_pass"],
          "description": "Subscription tier controlling AI Tutor & Descriptive Evaluator access"
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "bn"],
          "description": "Preferred UI and test language (English or Bengali)"
        },
        "targetExamSlug": {
          "type": "string",
          "enum": [
            "wbcs-prelims",
            "wbcs-mains",
            "wbpsc-clerkship-part1",
            "wbpsc-clerkship-part2",
            "wbpsc-miscellaneous",
            "wbpsc-food-si",
            "wbp-constable-si"
          ],
          "description": "Primary WBPSC target examination"
        },
        "dailyAiQueriesUsed": {
          "type": "integer",
          "description": "Count of AI queries used today (capped at 15/day for Pro users)"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the user account is active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile last update server timestamp"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "subscriptionTier",
        "preferredLanguage",
        "targetExamSlug",
        "dailyAiQueriesUsed",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Trusted admin lookup record used by Firestore rules isAdmin() helper.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
