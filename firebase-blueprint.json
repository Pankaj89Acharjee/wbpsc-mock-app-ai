  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and RBAC state. Read restricted to owner or Admin."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Trusted Admin UID registry for zero-trust role checks."
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/ExamConfig" },
      "description": "WBPSC exam definitions managed by Admins."
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/BilingualQuestion" },
      "description": "Bilingual WBPSC MCQ bank managed by Admins and Educators."
    },
    "/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/TestAttemptRecord" },
      "description": "Submitted mock test grading attempts."
    },
    "/mastery/{masteryId}": {
      "schema": { "$ref": "#/entities/SubtopicMasteryRecord" },
      "description": "Per-user subtopic mastery and weakness metrics."
    },
    "/aiNotesCache/{noteId}": {
      "schema": { "$ref": "#/entities/AiNoteCacheRecord" },
      "description": "Cached bilingual study notes and Current Affairs digests."
    }
  }
}
