# ============================================================================
# WBPSC AI Mock Test & Tutor (wbpsc-ai-prep) — Master Environment Configuration
# Supports Local Dev (8GB RAM PC + Vivo X200 FE LAN) & Google Cloud Run
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Runtime & Server Ports (Cloud Run defaults to 8080)
# ----------------------------------------------------------------------------
NODE_ENV="development"
PORT="8080"
API_CORE_PORT="8080"
API_AI_PORT="8081"
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 2. PostgreSQL 16 + pgvector (Local Docker 384MB OR Supabase Free Tier)
# ----------------------------------------------------------------------------
POSTGRES_USER="wbpsc_admin"
POSTGRES_PASSWORD="wbpsc_local_dev_2026"
POSTGRES_DB="wbpsc_prep"
POSTGRES_PORT="5432"

# Primary Connection URL (Used by Drizzle ORM in apps/api-core & asyncpg in apps/api-ai)
# Local Docker:
DATABASE_URL="postgresql://wbpsc_admin:wbpsc_local_dev_2026@localhost:5432/wbpsc_prep"
# Cloud / Supabase Pooled (Transaction mode, port 6543) — uncomment to save local RAM:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DB_MAX_CONNECTIONS="10"
DB_IDLE_TIMEOUT_SECONDS="20"

# ----------------------------------------------------------------------------
# 3. Redis 7.4 (Local Docker 128MB OR Upstash Serverless Redis)
# Used for Tier-1 AI Note Cache (exam_slug:topic_slug:lang) & Rate Limiting
# ----------------------------------------------------------------------------
REDIS_PORT="6379"
REDIS_PASSWORD="wbpsc_redis_local_2026"
REDIS_URL="redis://:wbpsc_redis_local_2026@localhost:6379/0"
# Upstash TLS alternative (uncomment to bypass local Docker Redis):
# REDIS_URL="rediss://default:[UPSTASH_TOKEN]@[ENDPOINT].upstash.io:6379"
AI_CACHE_TTL_SECONDS="2592000" # 30 days L1 Redis TTL (L2 PostgreSQL is permanent)

# ----------------------------------------------------------------------------
# 4. Google AI Studio (apps/api-ai — FastAPI + google-genai SDK)
# ----------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyBeSTtUGw23MzwGrXeKllXoiMSNjhrlNi0"
GEMINI_PRIMARY_MODEL="gemini-3.1-flash-lite-preview"
GEMINI_EVAL_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# ----------------------------------------------------------------------------
# 5. Authentication & Security (apps/api-core — Fastify JWT)
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET="replace-with-64-char-hex-access-secret-for-wbpsc-api-core"
JWT_REFRESH_SECRET="replace-with-64-char-hex-refresh-secret-for-wbpsc-api-core"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
INTERNAL_SERVICE_TOKEN="replace-with-shared-secret-between-api-core-and-api-ai"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://192.168.1.100:8081,https://wbpsc-prep.in"
# Interim admin guard for /admin/* routes (sent as x-admin-key) until JWT auth lands
ADMIN_API_KEY=d706743b-3f0e-491d-8cd1-3af42b850b28
# ----------------------------------------------------------------------------
# 6. Razorpay Subscriptions & Webhooks (apps/api-core)
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_hmac_secret"

# ----------------------------------------------------------------------------
# 7. Next.js 15 Web Client (apps/web)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_CORE_URL="http://localhost:8080"
NEXT_PUBLIC_API_AI_URL="http://localhost:8081"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
NEXT_PUBLIC_DEFAULT_LOCALE="bn"

# ----------------------------------------------------------------------------
# 8. React Native Expo SDK 52+ (apps/mobile — Vivo X200 FE over LAN Wi-Fi)
# IMPORTANT: Replace 192.168.1.100 with your PC's IPv4 address (`ipconfig` / `hostname -I`)
# when running `npx expo start --lan`
# ----------------------------------------------------------------------------
EXPO_PUBLIC_API_CORE_URL="http://192.168.1.100:8080"
EXPO_PUBLIC_API_AI_URL="http://192.168.1.100:8081"
EXPO_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
EXPO_PUBLIC_DEFAULT_LANGUAGE="bn"

# Single admin (api-core). Set ADMIN_PASSWORD to sign in with email + password; GOOGLE_CLIENT_ID enables "Continue with Google".
ADMIN_EMAIL="pankaj2007acharjee@gmail.com"
ADMIN_PASSWORD="Pankaj#2026"
GOOGLE_CLIENT_ID="180196659371-sj7hgmv0b9qrsr6s4t3i6vpe9ieivcsv.apps.googleusercontent.com"
