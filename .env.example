# ============================================================================
# WBPSC AI Mock Test & Tutor (wbpsc-ai-prep) — Master Environment Configuration
# Supports Google AI Studio, Local PC (8GB RAM + Vivo X200 FE LAN) & Oracle VM
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Runtime & Server Ports
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_CORE_PORT=8080
API_AI_PORT=8081
API_AI_URL=http://localhost:8081
APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 2. PostgreSQL 16 + pgvector (Local Docker 384MB / Oracle VM / Supabase)
# ----------------------------------------------------------------------------
POSTGRES_USER=wbpsc_admin
POSTGRES_PASSWORD=wbpsc_local_dev_2026
POSTGRES_DB=wbpsc_prep
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wbpsc_admin:wbpsc_local_dev_2026@localhost:5432/wbpsc_prep
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_SECONDS=20
# Apply apps/api-core/migrations/*.sql when api-core starts. When false, api-core
# refuses to start while migrations are pending — run `npm run db:migrate` instead.
DB_MIGRATE_ON_START=false
# Integration tests (npm run test:api-core) recreate this database — name must contain "test"
# TEST_DATABASE_URL=postgresql://wbpsc_admin:wbpsc_local_dev_2026@localhost:5432/wbpsc_test_core
# Stem similarity (0–1) above which a question counts as a reworded duplicate
QUESTION_NEAR_DUP_THRESHOLD=0.8

# ----------------------------------------------------------------------------
# 3. Redis 7.4 (Local Docker 128MB / Upstash Redis)
# ----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=wbpsc_redis_local_2026
REDIS_URL=redis://:wbpsc_redis_local_2026@localhost:6379/0
AI_CACHE_TTL_SECONDS=2592000

# ----------------------------------------------------------------------------
# 4. Google AI Studio (Gemini API)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_EVAL_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# ----------------------------------------------------------------------------
# 5. Authentication, Session & Admin RBAC (apps/api-core)
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=wbpsc-ai-prep-default-hs256-session-secret-key-2026-secure-token
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
INTERNAL_SERVICE_TOKEN="replace-with-shared-secret-between-api-core-and-api-ai"
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://192.168.1.100:8081,https://wbpsc-prep.in

# Bootstrap Admin Account (sign in with Email/Password or Google)
ADMIN_EMAIL=pankaj2007acharjee@gmail.com
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
ADMIN_API_KEY=

# ----------------------------------------------------------------------------
# 6. Web Client (Vite / Next.js)
# ----------------------------------------------------------------------------
VITE_API_CORE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_CORE_URL=http://localhost:8080
NEXT_PUBLIC_API_AI_URL=http://localhost:8081
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# ----------------------------------------------------------------------------
# 7. React Native Expo SDK 52+ (Vivo X200 FE over LAN Wi-Fi)
# ----------------------------------------------------------------------------
EXPO_PUBLIC_API_CORE_URL=http://192.168.1.100:8080
EXPO_PUBLIC_API_AI_URL=http://192.168.1.100:8081
EXPO_PUBLIC_DEFAULT_LANGUAGE=bn

# ----------------------------------------------------------------------------
# 8. Production Oracle VM (docker-compose.prod.yml + Caddy)
# ----------------------------------------------------------------------------
SITE_ADDRESS=:80
